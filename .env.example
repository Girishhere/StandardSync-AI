# StandardSync AI — Root Environment Configuration
# Copy this file to .env and customise.

# ── Demo / AI Mode ────────────────────────────────────────────────────────────
DEMO_MODE=true
SIMILARITY_THRESHOLD=0.60
FAISS_TOP_K=5

# ── Backend ───────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── MongoDB (optional, used when DEMO_MODE=false) ────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=standardsync

# ── Embedding model (used when DEMO_MODE=false) ───────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
