# StandardSync AI — Backend Environment Configuration
# Copy this file to .env and adjust values as needed

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Demo / AI Mode ────────────────────────────────────────────────────────────
# Set to true to run without MongoDB, FAISS index, or embedding model.
# The application uses local seeded data with deterministic retrieval.
DEMO_MODE=true

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Cosine similarity threshold (0–1). Queries below this score return "not found".
SIMILARITY_THRESHOLD=0.60
# Number of candidates retrieved from FAISS before threshold filtering
FAISS_TOP_K=5
# Embedding model (used only when DEMO_MODE=false)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ── MongoDB (optional, used when DEMO_MODE=false) ────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=standardsync

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
